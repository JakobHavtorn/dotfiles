#!/usr/bin/env bash
# run_onchange_after_70-pipx.sh.tmpl
set -euo pipefail
source "{{ .chezmoi.sourceDir }}/shared/log.sh"

# Install pipx packages from manifest.
# Re-runs when this script or the manifest changes.
# pipx hash: {{ include "manifests/pipx.txt" | sha256sum }}

if ! command -v pipx >/dev/null 2>&1; then
    log_skip "pipx (not installed)"
    exit 0
fi

MANIFEST="{{ .chezmoi.sourceDir }}/manifests/pipx.txt"

log_section "pipx packages"
while IFS='|' read -r pkg source; do
    # skip comments and empty lines
    [[ "$pkg" =~ ^# ]] && continue
    [[ -z "$pkg" ]] && continue
    # source is optional: defaults to PyPI package name
    install_target="${source:-$pkg}"
    if pipx list --short 2>/dev/null | awk '{print $1}' | grep -qx "$pkg"; then
        log_ok "$pkg: already installed"
    else
        log_info "installing $pkg..."
        pipx install "$install_target"
    fi
done < "$MANIFEST"
log_ok "pipx done"
