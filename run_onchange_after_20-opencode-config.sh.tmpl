#!/usr/bin/env bash
set -euo pipefail

# opencode.jsonc base — hash triggers re-run on config changes
# opencode.jsonc hash: {{ include "dot_config/opencode/opencode.jsonc" | sha256sum }}

# to generate model specs into the live config.
# Re-runs when this script or the base config changes.

OPENCODE_CONFIG_DIR="${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}"
SOURCE_DIR="{{ .chezmoi.sourceDir }}"
BASE_CONFIG="$SOURCE_DIR/dot_config/opencode/opencode.jsonc"
LIVE_CONFIG="$OPENCODE_CONFIG_DIR/opencode.jsonc"

echo "=== opencode config + corti models ==="

mkdir -p "$OPENCODE_CONFIG_DIR"

# Copy base config (without generated model specs)
cp "$BASE_CONFIG" "$LIVE_CONFIG"
echo "  applied base opencode.jsonc"

# Generate model specs via corti CLI
if command -v npx &>/dev/null; then
    echo "  running corti models init..."
    npx @corti/cli@latest models init \
        --tools opencode --scope global --yes --no-shell-rc \
        --model corti-s1,corti-s1-instant,corti-s1-mini,corti-s1-mini-instant,corti-s1-beta,corti-s1-embedding,corti-s1-ultra-beta,corti-s1-tiny,corti-s1-tiny-instant \
        2>&1 | sed 's/^/    /'
else
    echo "  WARNING: npx not found — skipping model init. Models will be bare stubs."
fi

echo "=== done ==="
