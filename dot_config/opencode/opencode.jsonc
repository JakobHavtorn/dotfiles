{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "corti": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Corti",
      "settings": {
        "baseURL": "https://ai.eu.corti.app/v1",
        "apiKey": "{env:CORTI_BEARER}"
      },
      "models": {
        "corti-s1": {
          "name": "Corti S1",
          "limit": {
            "context": 262144,
            "output": 262144
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "cost": {
            "input": 2,
            "output": 8,
            "cache": {
              "read": 0.2
            }
          },
          "compatibility": {
            "reasoningField": "reasoning"
          }
        },
        "corti-s1-instant": {
          "name": "Corti S1 Instant",
          "limit": {
            "context": 262144,
            "output": 262144
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "cost": {
            "input": 2,
            "output": 8,
            "cache": {
              "read": 0.2
            }
          }
        },
        "corti-s1-mini": {
          "name": "Corti S1 Mini",
          "limit": {
            "context": 262144,
            "output": 262144
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "cost": {
            "input": 1,
            "output": 4,
            "cache": {
              "read": 0.1
            }
          },
          "compatibility": {
            "reasoningField": "reasoning"
          }
        },
        "corti-s1-mini-instant": {
          "name": "Corti S1 Mini Instant",
          "limit": {
            "context": 262144,
            "output": 262144
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "cost": {
            "input": 1,
            "output": 4,
            "cache": {
              "read": 0.1
            }
          }
        },
        "corti-s1-beta": {
          "name": "Corti S1 Beta",
          "limit": {
            "context": 1048576,
            "output": 262144
          }
        },
        "corti-s1-embedding": {
          "name": "Corti S1 Embedding",
          "limit": {
            "context": 16384,
            "output": 16384
          },
          "cost": {
            "input": 0.03,
            "output": 0
          }
        },
        "corti-s1-ultra-beta": {
          "name": "Corti S1 Ultra Beta"
        },
        "corti-s1-tiny": {
          "name": "Corti S1 Tiny"
        },
        "corti-s1-tiny-instant": {
          "name": "Corti S1 Tiny Instant"
        }
      }
    }
  },
  "model": "corti/corti-s1",
  "permissions": [
    { "action": "notion_notion-create-*", "resource": "*", "effect": "deny" },
    { "action": "notion_notion-update-folder", "resource": "*", "effect": "deny" },
    { "action": "notion_notion-update-view", "resource": "*", "effect": "deny" },
    { "action": "notion_notion-create-view", "resource": "*", "effect": "deny" },
    { "action": "notion_notion-create-database", "resource": "*", "effect": "deny" },
    { "action": "notion_notion-create-folder", "resource": "*", "effect": "deny" },
    { "action": "notion_notion-create-comment", "resource": "*", "effect": "deny" },
    { "action": "notion_notion-create-pages", "resource": "*", "effect": "deny" },
    { "action": "notion_notion-create-file-upload", "resource": "*", "effect": "deny" },
    { "action": "notion_notion-create-attachment", "resource": "*", "effect": "deny" },
    { "action": "notion_notion-duplicate-page", "resource": "*", "effect": "deny" },
    { "action": "notion_notion-download-attachment", "resource": "*", "effect": "deny" },
    { "action": "notion_notion-move-pages", "resource": "*", "effect": "deny" },
    { "action": "notion_notion-update-data-source", "resource": "*", "effect": "deny" },
    { "action": "notion_notion-get-comments", "resource": "*", "effect": "deny" },
    { "action": "notion_notion-get-users", "resource": "*", "effect": "deny" },
    { "action": "notion_notion-get-teams", "resource": "*", "effect": "deny" },
    { "action": "notion_notion-get-session-status", "resource": "*", "effect": "deny" },
    { "action": "notion_notion-list-*", "resource": "*", "effect": "deny" },
    { "action": "notion_notion-query-meeting-notes", "resource": "*", "effect": "deny" },
    { "action": "notion_notion-query-sessions", "resource": "*", "effect": "deny" },
    { "action": "notion_notion-search-sessions", "resource": "*", "effect": "deny" },
    { "action": "notion_notion-search-agents", "resource": "*", "effect": "deny" },
    { "action": "notion_notion-spawn-session", "resource": "*", "effect": "deny" },
    { "action": "notion_notion-stop-session", "resource": "*", "effect": "deny" },
    { "action": "notion_notion-send-message-to-session", "resource": "*", "effect": "deny" },
    { "action": "notion_notion-wait-session", "resource": "*", "effect": "deny" },
    { "action": "notion_notion-read-session-event", "resource": "*", "effect": "deny" },
    { "action": "notion_notion-list-session-events", "resource": "*", "effect": "deny" },
    { "action": "notion_notion-notion-convert-page-to-skill", "resource": "*", "effect": "deny" }
  ],
  "mcp": {
    "servers": {
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp",
        "oauth": {},
        "disabled": false,
        "timeout": {
          "catalog": 30000,
          "execution": 30000
        }
      },
      "slack": {
        "type": "remote",
        "url": "https://mcp.slack.com/mcp",
        "oauth": {
          "client_id": "{env:SLACK_CLIENT_ID}",
          "client_secret": "{env:SLACK_CLIENT_SECRET}",
          "scope": "search:read.public search:read.private search:read.mpim search:read.im search:read.files files:read search:read.users chat:write users:read users:read.email channels:history groups:history mpim:history im:history",
          "callback_port": 19876,
          "redirect_uri": "http://127.0.0.1:19876/mcp/oauth/callback"
        },
        "disabled": false,
        "timeout": {
          "catalog": 30000,
          "execution": 30000
        }
      },
      "synapse": {
        "type": "remote",
        "url": "https://mcp.synapse.corti.app/mcp",
        "oauth": {
          "client_id": "synapse-mcp",
          "scope": "openid email profile offline_access"
        },
        "disabled": false,
        "timeout": {
          "catalog": 30000,
          "execution": 30000
        }
      },
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp",
        "oauth": {},
        "disabled": false,
        "timeout": {
          "catalog": 30000,
          "execution": 30000
        }
      }
    }
  },
  "plugins": [
    "@plannotator/opencode@latest",
    "@cortexkit/opencode-magic-context@latest",
    "@cortexkit/aft-opencode@latest"
  ],
  "compaction": {
    "auto": false
  }
}
