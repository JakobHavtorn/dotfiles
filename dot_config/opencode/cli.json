{
  "$schema": "https://opencode.ai/v2/cli.json",
  "plugins": [
    "@cortexkit/opencode-magic-context@latest",
    "@cortexkit/aft-opencode@latest"
  ],
  "scroll": {
    "acceleration": false
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "tabs": {
    "mode": "off"
  },
  "animations": true
}
