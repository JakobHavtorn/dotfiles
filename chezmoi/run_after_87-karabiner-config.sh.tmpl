#!/usr/bin/env bash
# run_after_87-karabiner-config.sh.tmpl
set -euo pipefail
source "{{ .chezmoi.sourceDir }}/shared/log.sh"

# Installs the Karabiner-Elements config manifest onto machines with no
# config yet. Runs every apply; the guard is the whole state check. The
# manifest appears once dump.sh captures a configured machine — until
# then the runtime guard skips cleanly.

{{ if eq .chezmoi.os "darwin" -}}

log_section "karabiner config"

MANIFEST="{{ .chezmoi.sourceDir }}/manifests/karabiner/karabiner.json"
LIVE="$HOME/.config/karabiner/karabiner.json"

if [ ! -f "$MANIFEST" ]; then
    log_skip "karabiner config (no manifest in repo yet — dump.sh will capture a configured machine)"
    exit 0
fi

if [ -f "$LIVE" ]; then
    log_skip "karabiner config (existing config — dump.sh observes it; delete $LIVE and re-apply to reset to repo state)"
    exit 0
fi

mkdir -p "$HOME/.config/karabiner"
cp "$MANIFEST" "$LIVE" 2>&1 | log_tee
log_ok "karabiner config installed"

{{ else -}}

log_skip "karabiner config (not darwin)"

{{ end -}}
