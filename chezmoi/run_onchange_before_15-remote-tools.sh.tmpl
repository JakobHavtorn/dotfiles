#!/usr/bin/env bash
# run_onchange_before_15-remote-tools.sh.tmpl
set -euo pipefail
source "{{ .chezmoi.sourceDir }}/shared/log.sh"
source "{{ .chezmoi.sourceDir }}/shared/env.sh"
source "{{ .chezmoi.sourceDir }}/shared/manifest.sh"

{{ if eq .chezmoi.os "linux" -}}

# Install CLI tools rootless to ~/.local/bin from pinned release URLs.
# Runs before file application so tools are available for after_ scripts.
# Re-runs when this script or remote-tools.txt changes.

# remote-tools.txt hash: {{ include "manifests/remote-tools.txt" | sha256sum }}

LOCAL_BIN="${LOCAL_BIN:-$HOME/.local/bin}"
VERSION_DIR="${VERSION_DIR:-$HOME/.local/share/remote-tools-versions}"
MANIFEST="${MANIFEST:-"{{ .chezmoi.sourceDir }}/manifests/remote-tools.txt"}"
ARCH="$(arch)"

if [[ "$ARCH" != "x86_64" ]]; then
    log_warn "remote-tools.txt has x86_64 URLs, but arch is $ARCH"
    log_info "some tools may fail to install. Add $ARCH entries to remote-tools.txt."
fi

mkdir -p "$LOCAL_BIN" "$VERSION_DIR"

# Per-run download cache (keyed by URL hash, so multiple entries from the same archive don't re-download)
CACHE_DIR="$(mktemp -d)"
trap 'rm -rf "$CACHE_DIR"' EXIT

# Install a single tool from the manifest. Called by manifest_each with
# the pipe-delimited fields: name, url, path_in_archive.
install_remote_tool() {
    local name="$1" url="$2" path_in_archive="$3"

    # Idempotent: skip if the pinned version is already installed
    local installed_url=""
    [[ -f "$VERSION_DIR/$name" ]] && installed_url="$(cat "$VERSION_DIR/$name")"
    if [[ "$installed_url" == "$url" ]]; then
        log_ok "$name: up to date"
        return 0
    fi

    log_info "installing $name..."

    local cache_key
    cache_key="$(printf '%s' "$url" | sha256sum | cut -d' ' -f1)"
    local cached="$CACHE_DIR/$cache_key"

    if [[ ! -d "$cached" ]]; then
        mkdir -p "$cached"
        if [[ "$path_in_archive" == "-" ]]; then
            # Direct binary download
            curl -fsSL "$url" -o "$cached/$name"
        else
            # Archive download + extract. tar xf auto-detects compression
            # (gzip, xz, bzip2) from file magic — but needs the matching
            # decompressor binary installed (gzip, xz, bzip2 respectively).
            curl -fsSL "$url" -o "$cached/archive"
            tar xf "$cached/archive" -C "$cached"
        fi
    fi

    if [[ "$path_in_archive" == "-" ]]; then
        if [[ ! -s "$cached/$name" ]]; then
            log_err "$name download failed"
            exit 1
        fi
        chmod +x "$cached/$name"
        mv "$cached/$name" "$LOCAL_BIN/$name"
    else
        local src="$cached/$path_in_archive"
        if [[ ! -f "$src" ]]; then
            log_err "$name not found at $path_in_archive in archive"
            exit 1
        fi
        chmod +x "$src"
        mv "$src" "$LOCAL_BIN/$name"
    fi

    log_ok "$name installed"
    echo "$url" > "$VERSION_DIR/$name"
}

manifest_each "$MANIFEST" "|" install_remote_tool

# Install a Python interpreter via uv and symlink python3 into LOCAL_BIN.
# uv python install puts the interpreter under
# ~/.local/share/uv/python/cpython-3.12-<platform>/bin/ but does not
# expose python3 on PATH. The symlink lets downstream scripts
# (agent-skills skillctl, etc.) find it.
if [[ -x "$LOCAL_BIN/uv" ]]; then
    log_info "installing Python 3.12 via uv..."
    "$LOCAL_BIN/uv" python install 3.12 || log_warn "uv python install failed"

    _py_bin_dir=""
    _py_bin_dir="$(dirname "$("$LOCAL_BIN/uv" python find 3.12 2>/dev/null)" 2>/dev/null)" || true
    if [[ -n "$_py_bin_dir" && -x "$_py_bin_dir/python3" ]]; then
        ln -sf "$_py_bin_dir/python3" "$LOCAL_BIN/python3"
        ln -sf "$_py_bin_dir/python3" "$LOCAL_BIN/python"
        log_ok "python3 linked to $LOCAL_BIN"
    else
        log_warn "python3 symlink failed (uv python find returned no path)"
    fi
    unset _py_bin_dir
fi

# Install pipx via uv tool. uv is already in LOCAL_BIN and uv tool
# installs executables to ~/.local/bin by default — same as LOCAL_BIN.
# This lets run_onchange_after_70-pipx.sh.tmpl install pipx packages.
if [[ -x "$LOCAL_BIN/uv" ]]; then
    if [[ -x "$LOCAL_BIN/pipx" ]]; then
        log_ok "pipx: up to date"
    else
        log_info "installing pipx via uv tool..."
        "$LOCAL_BIN/uv" tool install pipx || log_warn "uv tool install pipx failed"
    fi
fi

# Install bun (single binary, distributed as a zip).
# Requires unzip on the system — add to apt-get prerequisites.
_install_bun() {
    local bun_version="bun-v1.4.3"
    local bun_url="https://github.com/oven-sh/bun/releases/download/${bun_version}/bun-linux-x64.zip"
    local installed_url=""
    [[ -f "$VERSION_DIR/bun" ]] && installed_url="$(cat "$VERSION_DIR/bun")"
    if [[ "$installed_url" == "$bun_url" && -x "$LOCAL_BIN/bun" ]]; then
        log_ok "bun: up to date"
        return 0
    fi
    if ! command -v unzip >/dev/null 2>&1; then
        log_warn "unzip not found — skipping bun install. Install with: apt-get install unzip"
        return 0
    fi
    log_info "installing bun..."
    local tmp_dir
    tmp_dir="$(mktemp -d)"
    if curl -fsSL "$bun_url" -o "$tmp_dir/bun.zip" && unzip -q "$tmp_dir/bun.zip" -d "$tmp_dir"; then
        chmod +x "$tmp_dir/bun-linux-x64/bun"
        mv "$tmp_dir/bun-linux-x64/bun" "$LOCAL_BIN/bun"
        echo "$bun_url" > "$VERSION_DIR/bun"
        log_ok "bun installed"
    else
        log_warn "bun download/extract failed"
    fi
    rm -rf "$tmp_dir"
}
_install_bun

# Install Node.js LTS (multi-file tarball: bin/ + lib/).
# Extract to ~/.local/share/node-<version>/ and symlink node, npm,
# npx into LOCAL_BIN. The internal symlinks (npm → ../lib/...) resolve
# relative to the extracted tree, so they work through the symlinks.
_install_node() {
    local node_version="v24.22.0"
    local node_url="https://nodejs.org/dist/${node_version}/node-${node_version}-linux-x64.tar.xz"
    local installed_url=""
    [[ -f "$VERSION_DIR/node" ]] && installed_url="$(cat "$VERSION_DIR/node")"
    if [[ "$installed_url" == "$node_url" && -x "$LOCAL_BIN/node" ]]; then
        log_ok "node: up to date"
        return 0
    fi
    log_info "installing Node.js ${node_version}..."
    local node_dest="$HOME/.local/share/node-${node_version}"
    local tmp_dir
    tmp_dir="$(mktemp -d)"
    if curl -fsSL "$node_url" -o "$tmp_dir/node.tar.xz" && tar xf "$tmp_dir/node.tar.xz" -C "$tmp_dir"; then
        rm -rf "$node_dest"
        mv "$tmp_dir/node-${node_version}-linux-x64" "$node_dest"
        ln -sf "$node_dest/bin/node" "$LOCAL_BIN/node"
        ln -sf "$node_dest/bin/npm" "$LOCAL_BIN/npm"
        ln -sf "$node_dest/bin/npx" "$LOCAL_BIN/npx"
        echo "$node_url" > "$VERSION_DIR/node"
        log_ok "node installed"
    else
        log_warn "node download/extract failed"
    fi
    rm -rf "$tmp_dir"
}
_install_node

# Install the Pi coding agent globally with the rootless node above
# (v24.22.0 ≥ Pi's Node ≥22.19 floor). npm -g with the default prefix
# is fine here: npm resolves its global bin against the node that runs
# it, so the binary lands in the node tree's bin/ — the same directory
# node/npm/npx are symlinked from. Link `pi` the same way. VERSION_DIR
# marker makes it idempotent; bumping the version here re-installs.
_install_pi() {
    local pi_package="@earendil-works/pi-coding-agent@1.5.2"
    local installed=""
    [[ -f "$VERSION_DIR/pi" ]] && installed="$(cat "$VERSION_DIR/pi")"
    if [[ "$installed" == "$pi_package" && -x "$LOCAL_BIN/pi" ]]; then
        log_ok "pi: up to date"
        return 0
    fi
    command -v npm >/dev/null 2>&1 || { log_warn "npm not found — skipping pi install"; return 0; }
    log_info "installing Pi ${pi_package}..."
    local npm_prefix
    npm_prefix="$(npm prefix -g 2>/dev/null)" || npm_prefix=""
    if [[ -z "$npm_prefix" ]]; then
        log_warn "npm prefix -g failed — skipping pi install"
        return 0
    fi
    if npm install -g --prefix "$npm_prefix" "$pi_package"; then
        if [[ -x "$npm_prefix/bin/pi" ]]; then
            ln -sf "$npm_prefix/bin/pi" "$LOCAL_BIN/pi"
            echo "$pi_package" > "$VERSION_DIR/pi"
            log_ok "pi installed"
        else
            log_warn "pi: installed but $npm_prefix/bin/pi missing"
        fi
    else
        log_warn "pi npm install failed"
    fi
}
_install_pi

log_ok "remote tools done"

{{ else -}}

log_skip "remote tools (not linux)"

{{ end -}}
