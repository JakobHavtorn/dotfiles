{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "linear": {
      "type": "http",
      "url": "{{ .coding_agents.mcp.servers.linear.url }}",
      "oauth": {}
    },
    "slack": {
      "type": "http",
      "url": "{{ .coding_agents.mcp.servers.slack.url }}",
      "oauth": {
        "clientId": "${SLACK_CLIENT_ID}",
        "clientSecret": "${SLACK_CLIENT_SECRET}",
        "scope": "{{ .coding_agents.mcp.servers.slack.scope }}",
        "redirectUri": "{{ .coding_agents.mcp.servers.slack.redirect_uri }}",
        "callbackPort": {{ .coding_agents.mcp.servers.slack.callback_port }}
      },
      "auth": {
        "type": "oauth",
        "tokenUrl": "{{ .coding_agents.mcp.servers.slack.auth_token_url }}",
        "clientId": "${SLACK_CLIENT_ID}",
        "clientSecret": "${SLACK_CLIENT_SECRET}"
      }
    },
    "synapse": {
      "type": "http",
      "url": "{{ .coding_agents.mcp.servers.synapse.url }}",
      "oauth": {
        "clientId": "{{ .coding_agents.mcp.servers.synapse.oauth_client_id }}",
        "scope": "{{ .coding_agents.mcp.servers.synapse.oauth_scope }}"
      }
    },
    "notion": {
      "type": "http",
      "url": "{{ .coding_agents.mcp.servers.notion.url }}",
      "oauth": {}
    },
    "google_calendar": {
      "type": "http",
      "url": "{{ .coding_agents.mcp.servers.google_calendar.url }}",
      "oauth": {
        "clientId": "${GOOGLE_CLIENT_ID}",
        "clientSecret": "${GOOGLE_CLIENT_SECRET}",
        "scope": "{{ .coding_agents.mcp.servers.google_calendar.scope }}",
        "redirectUri": "{{ .coding_agents.mcp.servers.google_calendar.redirect_uri }}",
        "callbackPort": {{ .coding_agents.mcp.servers.google_calendar.callback_port }}
      },
      "auth": {
        "type": "oauth",
        "tokenUrl": "{{ .coding_agents.mcp.servers.google_calendar.auth_token_url }}",
        "clientId": "${GOOGLE_CLIENT_ID}",
        "clientSecret": "${GOOGLE_CLIENT_SECRET}"
      }
    },
    "google_drive": {
      "type": "http",
      "url": "{{ .coding_agents.mcp.servers.google_drive.url }}",
      "oauth": {
        "clientId": "${GOOGLE_CLIENT_ID}",
        "clientSecret": "${GOOGLE_CLIENT_SECRET}",
        "scope": "{{ .coding_agents.mcp.servers.google_drive.scope }}",
        "redirectUri": "{{ .coding_agents.mcp.servers.google_drive.redirect_uri }}",
        "callbackPort": {{ .coding_agents.mcp.servers.google_drive.callback_port }}
      },
      "auth": {
        "type": "oauth",
        "tokenUrl": "{{ .coding_agents.mcp.servers.google_drive.auth_token_url }}",
        "clientId": "${GOOGLE_CLIENT_ID}",
        "clientSecret": "${GOOGLE_CLIENT_SECRET}"
      }
    }
  }
}
