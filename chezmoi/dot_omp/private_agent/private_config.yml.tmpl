setupVersion: 2
retry:
  enabled: true
  maxRetries: 20
  maxDelayMs: 600000
modelRoles:
  default: corti/{{ .coding_agents.corti.default_model }}
  slow: corti/corti-s1:max
  smol: corti/corti-s1-mini-beta:xhigh
  plan: corti/corti-s1:max
  task: corti/corti-s1:max
  commit: corti/corti-s1-mini-instant
  tiny: corti/corti-s1-mini-instant
  advisor: corti/corti-s1-mini-beta:xhigh
  vision: corti/corti-s1-mini
tools:
  approvalMode: yolo
  approval:
    bash: allow
{{- /* Notion — deny write/session tools, rendered from .chezmoidata notion.deny_actions */}}
{{- range $action := .coding_agents.notion.deny_actions }}
    mcp__notion_{{ $action | replace "notion-" "" | replace "-" "_" }}: deny
{{- end }}
lsp:
  enabled: true
  lazy: true
  diagnosticsOnWrite: true
  formatOnWrite: false
  diagnosticsOnEdit: true
bash:
  enabled: true
  direnv: auto
ask:
  notify: "on"
  enabled: true
theme:
  dark: everforest
symbolPreset: nerd
statusLine:
  preset: default
  separator: powerline-thin
  sessionAccent: true
  transparent: true
defaultThinkingLevel: auto
compaction:
  enabled: true
  autoContinue: true
  thresholdPercent: 80
  methodOrder:
    - remote
    - soft
eval:
  py: true
  js: true
memory:
  backend: mnemopi
power:
  sleepPrevention: idle
github:
  enabled: true
disabledProviders:
  - github
hideThinkingBlock: true
inlineToolDescriptors: auto
advisor:
  enabled: true
  # React faster: fast reviewer model (modelRoles.advisor), and the primary
  # waits up to 30s for the advisor to finish before running past its backlog.
  syncBacklog: 1
  # React less: after one concern interrupts, further concerns ride as
  # non-interrupting asides for this many turns. Not a startup-silence knob.
  immuneTurns: 6
  # React less: cap non-blocker notes per review, and only a blocker re-wakes
  # the agent after a final answer (concerns stay as visible cards).
  maxNotesPerUpdate: 2
  continueSeverity: blocker
python:
  kernelMode: session
task:
  eager: preferred
  enableEffort: true
  maxEffort: max
  isolation:
    enabled: true
    commits: ai
isolation:
  backend: auto
error:
  notify: "on"
startup:
  checkUpdate: false
features:
  unexpectedStopDetection: smart
composer:
  shape: claude
todo:
  enabled: true
web_search:
  enabled: true
title:
  refreshOnReplan: false
terminal:
  showProgress: true
