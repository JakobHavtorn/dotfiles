#!/usr/bin/env bash
# run_onchange_after_90-macos-defaults.sh.tmpl
set -euo pipefail
source "{{ .chezmoi.sourceDir }}/shared/log.sh"

# macOS defaults keys shared artifact — the (domain, key, value) triples.
# Re-run when this script or the keys file changes.
# macos-defaults-keys hash: {{ include "manifests/macos-defaults-keys.txt" | sha256sum }}

{{ if eq .chezmoi.os "darwin" -}}

log_section "setting macOS defaults"

KEYS_FILE="{{ .chezmoi.sourceDir }}/manifests/macos-defaults-keys.txt"

if [[ ! -f "$KEYS_FILE" ]]; then
    log_err "macOS defaults keys file not found: $KEYS_FILE"
    exit 1
fi

# Lines: domain|key|value — value is the raw args to 'defaults write'.
# Per-key non-fatal: a bad domain (corrupt plist, wedged cfprefd, or a
# restricted key) logs the underlying error and never blocks the apply —
# later layers (duti, the report) and the next apply depend on that.
# A refused write falls back to a read-back: when the current value already
# matches, the key counts as set and stays quiet — a TCC/App-Management-
# locked plist (seen on a managed MacBook) stops nagging once the value is
# right. Failed keys do not auto-retry (chezmoi records the successful run),
# but dump.sh observes every key weekly, so a never-landing key stays
# visible in macos-defaults.txt until fixed by hand.
_failed=0
while IFS='|' read -r domain key value; do
    # skip comments and blank lines
    [[ "$domain" =~ ^[[:space:]]*# ]] && continue
    [[ -z "$domain" ]] && continue
    if _out="$(defaults write "$domain" "$key" $value 2>&1)"; then
        log_info "defaults write $domain $key $value"
    else
        _want=""
        case "$value" in
            "-bool true")  _want="1" ;;
            "-bool false") _want="0" ;;
            -int*|-float*|-string*) _want="${value#-* }" ;;
        esac
        _cur="$(defaults read "$domain" "$key" 2>/dev/null)" || _cur=""
        if [ -n "$_want" ] && [ "$_cur" = "$_want" ]; then
            log_info "defaults $domain $key already $_cur (write refused, value correct)"
        else
            log_warn "defaults write failed: $domain $key — $_out"
            _failed=1
        fi
    fi
done < "$KEYS_FILE"

# Apply changes
killall Dock 2>/dev/null || true
killall Finder 2>/dev/null || true

if [[ "$_failed" -eq 1 ]]; then
    log_err "some defaults failed — see warnings above; dump.sh reports the drift weekly until fixed"
else
    log_ok "macOS defaults set"
fi

{{ else -}}

log_skip "macOS defaults (not darwin)"

{{ end -}}
