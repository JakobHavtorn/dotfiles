#!/usr/bin/env bash
# run_onchange_after_86-obsidian-mcp.sh.tmpl
#
# Registers the Obsidian Local REST API MCP server with coding agents that
# don't have their MCP config managed by chezmoi templates (OMP and opencode
# are templated directly). Claude Code stores user-scoped MCP in ~/.claude.json
# (a large stateful file that cannot be templated), and Codex stores MCP in
# ~/.codex/config.toml (mixed with hand-managed project trust entries).
#
# Both need the Obsidian API key. The key lives in the vault's plugin data.json
# (generated by the plugin on first run). We read it from there so the script
# is self-contained — no env var or secret in the dotfiles.
#
# Re-runs when this script or the chezmoidata source changes:
# chezmoidata hash: {{ include ".chezmoidata.yaml" | sha256sum }}
set -euo pipefail
source "{{ .chezmoi.sourceDir }}/shared/log.sh"
source "{{ .chezmoi.sourceDir }}/shared/env.sh"

if is_ci; then
    log_skip "obsidian mcp (CI environment)"
    exit 0
fi

VAULT="${OBSIDIAN_VAULT_PATH:-$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents/Zettelkasten}"
PLUGIN_DATA="$VAULT/.obsidian/plugins/obsidian-local-rest-api/data.json"
OBSIDIAN_URL="{{ .coding_agents.mcp.servers.obsidian.url }}"

# ── Extract API key from plugin data.json ────────────────────────────────────

if [[ ! -f "$PLUGIN_DATA" ]]; then
    log_skip "obsidian mcp (plugin not installed — no data.json)"
    exit 0
fi

API_KEY=$(python3 -c "
import json, sys
with open('$PLUGIN_DATA') as f:
    d = json.load(f)
print(d.get('apiKey', ''))
" 2>/dev/null)

if [[ -z "$API_KEY" ]]; then
    log_warn "obsidian mcp (no apiKey in plugin data.json)"
    exit 0
fi

log_section "obsidian mcp"

# ── Claude Code (~/.claude.json → mcpServers.obsidian) ────────────────────────

if command -v claude >/dev/null 2>&1; then
    # claude mcp add is idempotent if the server already exists with the same URL.
    # Remove first to update headers if the key changed, then re-add.
    claude mcp remove obsidian --scope user >/dev/null 2>&1 || true
    if claude mcp add --transport http --scope user obsidian "$OBSIDIAN_URL" \
         --header "Authorization: Bearer $API_KEY" >/dev/null 2>&1; then
        log_ok "claude code: obsidian mcp registered"
    else
        log_warn "claude code: failed to register obsidian mcp"
    fi
else
    log_skip "claude code (not installed)"
fi

# ── Codex (~/.codex/config.toml → [mcp_servers.obsidian]) ─────────────────────
#
# Codex supports bearer_token_env_var, so the key lives in an env var, not
# in the config file. We set the env var in fish_variables (user does this
# manually) and reference it here. The config.toml entry is just the URL
# and the env var name.
#
# Codex's config.toml has hand-managed sections (personality, project trust,
# features). We append the [mcp_servers.obsidian] block idempotently rather
# than templating the whole file.

CODEX_CONFIG="$HOME/.codex/config.toml"

if [[ ! -d "$HOME/.codex" ]]; then
    log_skip "codex (~/.codex not found)"
else
    if grep -q '\[mcp_servers\.obsidian\]' "$CODEX_CONFIG" 2>/dev/null; then
        log_skip "codex (obsidian mcp already in config.toml)"
    else
        cat >> "$CODEX_CONFIG" <<EOF

[mcp_servers.obsidian]
url = "$OBSIDIAN_URL"
bearer_token_env_var = "OBSIDIAN_API_KEY"
EOF
        log_ok "codex: obsidian mcp added to config.toml"
        log_warn "codex: set OBSIDIAN_API_KEY env var to the plugin's API key"
    fi
fi

log_ok "obsidian mcp done"
