#!/usr/bin/env bash
# run_once_before_10-install-homebrew.sh.tmpl
set -euo pipefail
source "{{ .chezmoi.sourceDir }}/shared/log.sh"

{{ if eq .chezmoi.os "darwin" -}}

# Install Homebrew if not present.
# Guard: official installer errors if brew already installed.

if command -v brew >/dev/null 2>&1; then
    log_skip "homebrew already installed"
    exit 0
fi

log_section "installing homebrew"
NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

# Add brew to PATH for this script's remainder
if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

log_ok "homebrew installed"

{{ else -}}

log_skip "homebrew install (not darwin)"

{{ end -}}
