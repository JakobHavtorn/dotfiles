#!/usr/bin/env bash
# run_onchange_after_87-iterm2-config.sh.tmpl
set -euo pipefail
source "{{ .chezmoi.sourceDir }}/shared/log.sh"

# Installs the iTerm2 settings manifest onto machines that have no iTerm2
# settings yet. A machine with existing settings is never overwritten —
# it is the source of truth and dump.sh observes it; to reset a machine to
# the repo state, delete the live plist and re-apply.
# presence fact — flips the hash when the live plist appears/disappears:
#   live iterm2 plist: {{ output "sh" "-c" "test -f $HOME/Library/Preferences/com.googlecode.iterm2.plist && echo present || echo absent" | trim }}
# iterm2 manifest hash: {{ include "manifests/iterm2/com.googlecode.iterm2.plist" | sha256sum }}

{{ if eq .chezmoi.os "darwin" -}}

log_section "iterm2 config"

MANIFEST="{{ .chezmoi.sourceDir }}/manifests/iterm2/com.googlecode.iterm2.plist"
LIVE="$HOME/Library/Preferences/com.googlecode.iterm2.plist"

if [ ! -f "$MANIFEST" ]; then
    log_skip "iterm2 config (no manifest in repo)"
    exit 0
fi

if [ -f "$LIVE" ]; then
    log_skip "iterm2 config (existing settings — dump.sh observes them; delete $LIVE and re-apply to reset to repo state)"
    exit 0
fi

defaults import com.googlecode.iterm2 "$MANIFEST"
log_ok "iterm2 settings installed — load on first iTerm2 launch"

{{ else -}}

log_skip "iterm2 config (not darwin)"

{{ end -}}
