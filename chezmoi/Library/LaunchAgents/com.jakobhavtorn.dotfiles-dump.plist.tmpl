<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jakobhavtorn.dotfiles-dump</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>{{ .chezmoi.sourceDir }}/../scripts/dump.sh &amp;&amp; {{ .chezmoi.sourceDir }}/../scripts/dump-pr.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>10</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/dotfiles-dump.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/dotfiles-dump.log</string>
</dict>
</plist>
