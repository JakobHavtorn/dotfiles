<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jakobhavtorn.dotfiles-dump</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>echo "--- dump $(date -Iseconds) ---" &gt;&gt; {{ .chezmoi.homeDir }}/Library/Logs/dotfiles-dump.log 2&gt;&amp;1 &amp;&amp; {{ .chezmoi.sourceDir }}/../scripts/dump.sh &gt;&gt; {{ .chezmoi.homeDir }}/Library/Logs/dotfiles-dump.log 2&gt;&amp;1 &amp;&amp; {{ .chezmoi.sourceDir }}/../scripts/dump-pr.sh &gt;&gt; {{ .chezmoi.homeDir }}/Library/Logs/dotfiles-dump.log 2&gt;&amp;1</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>10</integer>
    </dict>
</dict>
</plist>
