#!/usr/bin/env bash
# run_onchange_after_70-pipx.sh.tmpl
set -euo pipefail
source "{{ .chezmoi.sourceDir }}/shared/log.sh"
source "{{ .chezmoi.sourceDir }}/shared/env.sh"
source "{{ .chezmoi.sourceDir }}/shared/manifest.sh"

# presence fact — flips this script's content hash when the precondition
# changes, so a guard-skip never permanently silences this layer:
#   pipx: {{ output "sh" "-c" "PATH=/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH command -v pipx >/dev/null 2>&1 && echo present || echo absent" | trim }}
# Install pipx packages from manifest.
# Re-runs when this script or the manifest changes.
# pipx hash: {{ include "manifests/pipx.txt" | sha256sum }}

if ! command -v pipx >/dev/null 2>&1; then
    log_skip "pipx (not installed)"
    exit 0
fi

MANIFEST="${MANIFEST:-"{{ .chezmoi.sourceDir }}/manifests/pipx.txt"}"

log_section "pipx packages"

# Install a single pipx package. Called by manifest_each with the
# pipe-delimited fields: pkg, optional source.
install_pipx_package() {
    local pkg="$1" source="${2:-}"
    # source is optional: defaults to PyPI package name
    local install_target="${source:-$pkg}"
    if pipx list --short 2>/dev/null | awk '{print $1}' | grep -qx "$pkg"; then
        log_ok "$pkg: already installed"
    else
        log_info "installing $pkg..."
        pipx install "$install_target" 2>&1 | log_tee
    fi
}

manifest_each "$MANIFEST" "|" install_pipx_package

log_ok "pipx done"
