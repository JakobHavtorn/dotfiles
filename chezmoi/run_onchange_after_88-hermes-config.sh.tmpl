#!/usr/bin/env bash
# run_onchange_after_88-hermes-config.sh.tmpl
#
# Installs or updates the Corti Hermes profile distribution from
# github.com/JakobHavtorn/hermes-profile. The distribution owns config.yaml,
# SOUL.md, cron/jobs.json, and skill wiring. We inject CORTI_BEARER into the
# profile's .env, and make it the sticky default profile.
#
# Replaces the previous sed-patch approach (88-hermes-config v1), which
# surgically edited Hermes's default config.yaml. The distribution approach
# is native Hermes tooling — versioned, clean install, and survives
# `hermes update` without pattern-matching fragility.
#
# Dependencies:
# - hermes CLI in PATH (installed by user, not chezmoi)
# - CORTI_BEARER in shell env or ~/.hermes/.env
#
# Hashes that trigger re-run when model definitions change:
# chezmoidata hash: {{ include ".chezmoidata.yaml" | sha256sum }}
set -euo pipefail
source "{{ .chezmoi.sourceDir }}/shared/log.sh"
source "{{ .chezmoi.sourceDir }}/shared/env.sh"

# presence fact — flips this script's content hash when the precondition
# changes, so a guard-skip never permanently silences this layer:
#   hermes: {{ output "sh" "-c" "PATH=/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH command -v hermes >/dev/null 2>&1 && echo present || echo absent" | trim }}
# ── Guards ──────────────────────────────────────────────────────────────────

if is_ci; then
    log_skip "hermes config (CI environment)"
    exit 0
fi

if ! command -v hermes >/dev/null 2>&1; then
    log_skip "hermes config (hermes CLI not installed)"
    exit 0
fi

HERMES_DIR="$HOME/.hermes"
HERMES_ENV="$HERMES_DIR/.env"
PROFILE_NAME="corti"
PROFILE_DIR="$HERMES_DIR/profiles/$PROFILE_NAME"
PROFILE_ENV="$PROFILE_DIR/.env"

log_section "hermes config (Corti profile distribution)"

# ── Install or update the distribution ──────────────────────────────────────

if [[ ! -f "$PROFILE_DIR/distribution.yaml" ]]; then
    log_info "installing corti profile distribution..."
    if ! hermes profile install github.com/JakobHavtorn/hermes-profile \
         --name "$PROFILE_NAME" --alias -y </dev/null 2>&1 | log_tee; then
        log_warn "profile install failed — Hermes may not be fully set up yet"
        exit 0
    fi
    log_ok "installed corti profile distribution"
else
    log_info "updating corti profile distribution..."
    # --force-config replaces config.yaml with the repo version.
    # Omit --force-config to preserve local config tweaks.
    if ! hermes profile update "$PROFILE_NAME" --force-config -y </dev/null 2>&1 | log_tee; then
        log_warn "profile update failed — continuing with existing config"
    else
        log_ok "updated corti profile distribution"
    fi
fi

# ── .env: ensure CORTI_BEARER ────────────────────────────────────────────────

# Hermes is a GUI app — it reads .env files, not shell env vars.
# Prefer the profile-specific .env; fall back to the default profile .env.
ENV_TARGET="$PROFILE_ENV"
if [[ ! -f "$ENV_TARGET" ]]; then
    ENV_TARGET="$HERMES_ENV"
fi

if [[ -n "${CORTI_BEARER:-}" ]] && ! grep -q '^CORTI_BEARER=' "$ENV_TARGET" 2>/dev/null; then
    cat >> "$ENV_TARGET" <<EOF

# =============================================================================
# LLM PROVIDER (Corti)
# =============================================================================
# OpenAI-compatible endpoint at https://ai.eu.corti.app/v1
CORTI_BEARER="$CORTI_BEARER"
EOF
    log_ok "added CORTI_BEARER to $ENV_TARGET"
elif grep -q '^CORTI_BEARER=' "$ENV_TARGET" 2>/dev/null; then
    log_skip "CORTI_BEARER already in $ENV_TARGET"
elif grep -q '^CORTI_BEARER=' "$HERMES_ENV" 2>/dev/null; then
    log_skip "CORTI_BEARER in default .env"
else
    log_warn "CORTI_BEARER not in shell env or any .env — Hermes won't authenticate"
fi

# ── .env: ensure SLACK_CLIENT_ID / SLACK_CLIENT_SECRET ────────────────────────

# Slack MCP is DCR-less — needs a pre-registered OAuth app. Credentials live
# in ~/.env (config.fish loads them into new shells); Hermes reads .env
# directly. Same pattern as CORTI_BEARER: pull from shell, write to profile
# .env if missing.
for slack_var in SLACK_CLIENT_ID SLACK_CLIENT_SECRET; do
    env_val="${!slack_var:-}"
    if [[ -n "$env_val" ]] && ! grep -q "^${slack_var}=" "$ENV_TARGET" 2>/dev/null; then
        echo "${slack_var}=${env_val}" >> "$ENV_TARGET"
        log_ok "added ${slack_var} to $ENV_TARGET"
    elif grep -q "^${slack_var}=" "$ENV_TARGET" 2>/dev/null; then
        log_skip "${slack_var} already in $ENV_TARGET"
    else
        log_warn "${slack_var} not in shell env or .env — Slack MCP won't authenticate"
    fi
done

# ── .env: ensure OBSIDIAN_LOCAL_REST_MCP_TOKEN ────────────────────────────────

# Obsidian Local REST API MCP needs a bearer token. It's written to ~/.env by
# run_onchange_after_86-obsidian-mcp.sh.tmpl. Hermes reads profile .env, not
# shell env — same injection pattern as CORTI_BEARER and Slack vars.
obs_var="OBSIDIAN_LOCAL_REST_MCP_TOKEN"
# Try shell env first, then ~/.env (where the 86 script writes it)
env_val="${!obs_var:-}"
if [[ -z "$env_val" ]] && [[ -f "$HOME/.env" ]]; then
    env_val=$(grep "^${obs_var}=" "$HOME/.env" 2>/dev/null | head -1 | cut -d= -f2-)
fi
if [[ -n "$env_val" ]] && ! grep -q "^${obs_var}=" "$ENV_TARGET" 2>/dev/null; then
    echo "${obs_var}=${env_val}" >> "$ENV_TARGET"
    log_ok "added ${obs_var} to $ENV_TARGET"
elif grep -q "^${obs_var}=" "$ENV_TARGET" 2>/dev/null; then
    log_skip "${obs_var} already in $ENV_TARGET"
else
    log_warn "${obs_var} not in shell env or ~/.env — Obsidian MCP won't authenticate"
fi

# ── Make corti the sticky default profile ────────────────────────────────────

if ! hermes profile show "$PROFILE_NAME" >/dev/null 2>&1; then
    log_warn "profile '$PROFILE_NAME' not found — skipping 'profile use'"
elif hermes profile list 2>/dev/null | grep -q '◆corti'; then
    log_skip "corti is already the active profile"
else
    # stderr stays discarded (as before); only stdout reaches the session log
    if hermes profile use "$PROFILE_NAME" </dev/null 2>/dev/null | log_tee; then
        log_ok "corti set as sticky default profile"
    else
        log_warn "could not set corti as default — run 'hermes profile use corti' manually"
    fi
fi

# ── Verify external_dirs resolve ─────────────────────────────────────────────

AGENT_SKILLS_DIR="$HOME/.agent-skills"
if [[ ! -d "$AGENT_SKILLS_DIR/plugins/coding/skills" ]]; then
    log_warn "agent-skills repo not found at $AGENT_SKILLS_DIR — external_dirs won't resolve"
else
    log_ok "agent-skills present — external_dirs will resolve"
fi
