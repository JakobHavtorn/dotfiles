#!/usr/bin/env bash
# run_after_99-bootstrap-report.sh.tmpl
#
# End-of-run report — the last step of every apply:
#   1. replays every warning and failure recorded during this apply
#      (warn/error lines from the session log),
#   2. replays every defer recorded by the layer probes
#      (defer lines from the session log),
#   3. prints the log path.
# Pure presentation — no machine probing; run_after_98-layer-defers is
# the probe home. Purely informational and non-fatal. Quiet when clean
# (one line). Complements scripts/check-bootstrap.sh, which detects
# interrupted applies via the chezmoi state DB.
#
# Renamed from run_after_99-bootstrap-doctor: the step summarizes the run,
# not just machine state — and "doctor" collides with the `chezmoi doctor`
# and AFT `doctor` subcommands.
set -euo pipefail
source "{{ .chezmoi.sourceDir }}/shared/log.sh"
source "{{ .chezmoi.sourceDir }}/shared/env.sh"

if is_ci; then
    log_skip "bootstrap report (CI environment)"
    exit 0
fi

log_section "bootstrap report"

# Warnings, failures, and defers from this apply. Read the session log
# BEFORE any of this script's own log calls, so this script's lines can
# never aggregate themselves; run_before_00's rotation already guarantees
# every line in the log belongs to this apply. Replays print via raw
# printf, not log_warn / log_err / log_defer, so they are not appended
# to the log again. Level lines are "HH:MM:SS LEVEL message": the level
# starts at char 9 — warn at offset 14, error and defer at offset 15
# (the message slice offsets follow).
_issues=0
_defers=0
if [ -f "$_SESSION_LOG" ]; then
    _agg="$(grep -E '^[0-9]{2}:[0-9]{2}:[0-9]{2} (warn|error) ' "$_SESSION_LOG" 2>/dev/null | awk '!seen[$0]++' || true)"
    _dagg="$(grep -E '^[0-9]{2}:[0-9]{2}:[0-9]{2} defer ' "$_SESSION_LOG" 2>/dev/null | awk '!seen[$0]++' || true)"

    if [ -n "$_agg" ]; then
        _count="$(printf '%s\n' "$_agg" | grep -c .)"
        log_warn "from this apply ($_count):"
        while IFS= read -r _line; do
            if [ "${_line:9:5}" = "error" ]; then
                printf '      %s✗%s %s\n' "$_RED" "$_RESET" "${_line:15}"
            else
                printf '      %s⚠%s %s\n' "$_YELLOW" "$_RESET" "${_line:14}"
            fi
        done <<< "$_agg"
        _issues=1
    fi

    if [ -n "$_dagg" ]; then
        _count="$(printf '%s\n' "$_dagg" | grep -c .)"
        log_warn "deferred ($_count):"
        while IFS= read -r _line; do
            printf '      %s⊘%s %s\n' "$_YELLOW" "$_RESET" "${_line:15}"
        done <<< "$_dagg"
        _defers=1
    fi
else
    log_skip "session log missing — replay skipped"
fi

# Verdict + log path. The clean line keeps the quiet-when-clean
# principle: one line including the log path. Each defer carries its
# own fix, so no closing hint is needed.
if [ "$_issues" -eq 0 ] && [ "$_defers" -eq 0 ]; then
    log_ok "clean — no warnings or failures, no pending layers · log: $_SESSION_LOG"
else
    log_info "log: $_SESSION_LOG"
fi
