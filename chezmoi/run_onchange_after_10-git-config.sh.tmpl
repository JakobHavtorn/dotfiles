#!/usr/bin/env bash
set -euo pipefail
source "{{ .chezmoi.sourceDir }}/shared/log.sh"
source "{{ .chezmoi.sourceDir }}/shared/env.sh"

log_section "git config"

if ! command -v git >/dev/null 2>&1; then
    log_warn "git not found — skipping git config"
    exit 0
fi

# Set individual keys via `git config --global` — never overwrite the
# whole config file. Existing credentials, hosts, aliases, and [url]
# sections on the machine are preserved.

git config --global user.name "{{ (index .identities .identity).name }}"
git config --global user.email "{{ (index .identities .identity).email }}"
git config --global init.defaultBranch main

# Global ignore for agent worktrees (kept out of every repo, all machines).
# Per-repo fallback: append '.worktrees/' to .git/info/exclude.
mkdir -p "${XDG_CONFIG_HOME:-$HOME/.config}/git"
echo '.worktrees/' >> "${XDG_CONFIG_HOME:-$HOME/.config}/git/ignore"
git config --global core.excludesFile "${XDG_CONFIG_HOME:-$HOME/.config}/git/ignore"

# insteadOf rewrites https -> ssh for github.com. Skipped in CI: keyless
# runners would fail every HTTPS clone (brew clones taps over git).
if ! is_ci; then
    git config --global url."git@github.com:".insteadOf "https://github.com/"
fi

log_ok "git config done"
