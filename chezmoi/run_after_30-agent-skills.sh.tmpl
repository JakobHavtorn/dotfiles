#!/usr/bin/env bash
# run_after_30-agent-skills.sh.tmpl
set -euo pipefail
source "{{ .chezmoi.sourceDir }}/shared/log.sh"
source "{{ .chezmoi.sourceDir }}/shared/env.sh"

# Clone agent-skills and link skills into opencode, omp, claude, and codex.
# Runs on every chezmoi apply — idempotent: git pull --ff-only is a no-op
# when current, skillctl link --force overwrites symlinks. This ensures
# upstream agent-skills changes (renames, new skills) propagate without
# needing to clear chezmoi's scriptState.
# skillctl link now handles skills, context file (AGENTS.md), and agents/*
# specs — all via a single mechanism.

AGENT_SKILLS_DIR="${AGENT_SKILLS_DIR:-$HOME/.agent-skills}"

log_section "agent-skills bootstrap"

if ! command -v git >/dev/null 2>&1; then
    log_warn "git not found — skipping agent-skills"
    exit 0
fi

# Private repo — skip in CI (no auth available). On real machines a
# clone/update failure (missing GitHub auth) is logged and never stops
# the bootstrap.
if is_ci; then
    log_skip "agent-skills (CI environment)"
    exit 0
fi

# No interactive prompts in bootstrap scripts: credential and host-key
#prompts must fail fast (caught below) instead of hanging the apply.
export GIT_TERMINAL_PROMPT=0
export GIT_SSH_COMMAND="ssh -o BatchMode=yes"

if [[ -d "$AGENT_SKILLS_DIR/.git" ]]; then
    log_info "updating $AGENT_SKILLS_DIR..."
    log_run --non-fatal "agent-skills update" git -C "$AGENT_SKILLS_DIR" pull --ff-only
else
    log_info "cloning to $AGENT_SKILLS_DIR..."
    if ! log_run "agent-skills clone" git clone https://github.com/JakobHavtorn/agent-skills.git "$AGENT_SKILLS_DIR"; then
        log_info "bootstrap continues without agent-skills"
        exit 0
    fi
fi

# Link skills, context file, and agents/*.md specs into each harness.
if command -v python3 >/dev/null 2>&1; then
    for agent in opencode omp claude codex; do
        log_run --non-fatal "linked skills into $agent" python3 "$AGENT_SKILLS_DIR/bin/skillctl" link --agent "$agent" --force
    done
else
    log_warn "python3 not found — skipping skill linking"
fi

log_ok "agent-skills done"
