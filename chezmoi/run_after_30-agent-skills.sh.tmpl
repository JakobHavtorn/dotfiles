#!/usr/bin/env bash
# run_after_30-agent-skills.sh.tmpl
set -euo pipefail
source "{{ .chezmoi.sourceDir }}/shared/log.sh"
source "{{ .chezmoi.sourceDir }}/shared/env.sh"

# Clone agent-skills and link skills into opencode, omp, claude, and codex.
# Runs on every chezmoi apply — idempotent: git pull --ff-only is a no-op
# when current, skillctl link --force overwrites symlinks. This ensures
# upstream agent-skills changes (renames, new skills) propagate without
# needing to clear chezmoi's scriptState.
# skillctl link now handles skills, context file (AGENTS.md), and agents/*
# specs — all via a single mechanism.

AGENT_SKILLS_DIR="${AGENT_SKILLS_DIR:-$HOME/.agent-skills}"

log_section "agent-skills bootstrap"

if ! command -v git >/dev/null 2>&1; then
    log_warn "git not found — skipping agent-skills"
    exit 0
fi

# Private repo — skip in CI (no auth available). On real machines a
# clone/update failure (missing GitHub auth) is logged and never stops
# the bootstrap.
if is_ci; then
    log_skip "agent-skills (CI environment)"
    exit 0
fi

# No interactive prompts in bootstrap scripts: credential and host-key
#prompts must fail fast (caught below) instead of hanging the apply.
export GIT_TERMINAL_PROMPT=0
export GIT_SSH_COMMAND="ssh -o BatchMode=yes"

if [[ -d "$AGENT_SKILLS_DIR/.git" ]]; then
    log_info "updating $AGENT_SKILLS_DIR..."
    _pre_sha="$(git -C "$AGENT_SKILLS_DIR" rev-parse HEAD)"
    _pull_rc=0
    _pull_out="$(git -C "$AGENT_SKILLS_DIR" pull --ff-only 2>&1)" || _pull_rc=$?
    _post_sha="$(git -C "$AGENT_SKILLS_DIR" rev-parse HEAD)"
    if [[ "$_pull_rc" -ne 0 ]]; then
        log_err "agent-skills update"
        printf '%s\n' "$_pull_out" >&2
    elif [[ "$_pre_sha" == "$_post_sha" ]]; then
        log_ok "agent-skills update (no changes)"
    else
        log_ok "agent-skills update"
    fi
    if [[ "$_pull_rc" -eq 0 && "$_pre_sha" != "$_post_sha" ]]; then
        # Extract skill names from changed paths under plugins/*/skills/<name>/.
        _changed="$(git -C "$AGENT_SKILLS_DIR" diff --name-only "$_pre_sha" "$_post_sha" \
            | sed -n 's|^plugins/[^/]*/skills/\([^/][^/]*\)/.*|\1|p' \
            | sort -u)"
        # Non-skill changes (skillctl, AGENTS.md, README, etc.) —
        # anything not under plugins/*/skills/.
        _other="$(git -C "$AGENT_SKILLS_DIR" diff --name-only "$_pre_sha" "$_post_sha" \
            | grep -v '^plugins/[^/]*/skills/' \
            | sort -u)"
        if [[ -n "$_changed" ]]; then
            while IFS= read -r _skill; do
                log_info "  changed: $_skill"
            done <<< "$_changed"
        fi
        if [[ -n "$_other" ]]; then
            _other_csv="$(paste -sd, - <<< "$_other")"
            log_info "  changed: $_other_csv"
        fi
    fi
    unset _pre_sha _post_sha _pull_rc _pull_out _changed _other _skill _other_csv
else
    log_info "cloning to $AGENT_SKILLS_DIR..."
    if ! log_run "agent-skills clone" git clone https://github.com/JakobHavtorn/agent-skills.git "$AGENT_SKILLS_DIR"; then
        log_info "bootstrap continues without agent-skills"
        exit 0
    fi
fi

# Link skills, context file, and agents/*.md specs into each harness.
# skillctl prints LINKED/COPIED for new or redirected symlinks and EXISTS
# for already-correct ones.  We surface only the LINKED/COPIED lines so
# the log shows symlink changes (new skills, renames, redirected paths)
# without noise from the common no-op case.
if command -v python3 >/dev/null 2>&1; then
    for agent in opencode omp claude codex; do
        _rc=0
        _link_out="$(python3 "$AGENT_SKILLS_DIR/bin/skillctl" link --agent "$agent" --force 2>&1)" || _rc=$?
        if [[ "$_rc" -ne 0 ]]; then
            log_err "synced skills into $agent"
            printf '%s\n' "$_link_out" >&2
        else
            _link_changed="$(grep -E '^  (LINKED|COPIED) ' <<< "$_link_out" || true)"
            if [[ -n "$_link_changed" ]]; then
                log_ok "synced skills into $agent"
                while IFS= read -r _line; do
                    log_info "$_line"
                done <<< "$_link_changed"
            else
                log_ok "synced skills into $agent (all current)"
            fi
        fi
    done
    unset _rc _link_out _link_changed _line
else
    log_warn "python3 not found — skipping skill linking"
fi

log_ok "agent-skills done"
