#!/usr/bin/env bash
# run_after_95-vscode-default-app.sh.tmpl
# Sets VS Code as the default app for common dev file types.
# Two binding layers, one per class:
#   1. duti — extensions with a registered macOS type. Supported public API.
#   2. LSHandlers — extensions with no type (.tsx, .fish, .go, .lock, ...).
#      duti cannot bind these. One atomic merge-write into the LaunchServices
#      domain: our entries are replaced, foreign entries and all other keys
#      are preserved.
# duti is installed by the Brewfile (dev tools section).
set -euo pipefail
source "{{ .chezmoi.sourceDir }}/shared/log.sh"
source "{{ .chezmoi.sourceDir }}/shared/env.sh"

{{ if eq .chezmoi.os "darwin" -}}

log_section "setting VS Code as default app for dev file types"

if ! command -v duti >/dev/null 2>&1; then
    log_warn "duti not found — arrives with brew bundle; re-apply from any shell to pick it up"
    exit 0
fi

APP="com.microsoft.VSCode"

# Extensions to bind to VS Code. duti takes the ."ext" form; extensions
# without a registered type fall through to the LSHandlers layer below.
EXTENSIONS=(
    # Languages
    js ts jsx tsx
    json jsonc
    py rb go rs c h cpp hpp java kt swift
    sh fish zsh bash
    yml yaml toml xml
    sql
    # Markup / data
    md markdown
    css scss sass less
    # Config / text
    txt log env conf ini cfg properties
    diff patch
    lock
    # Frameworks / ecosystems
    vue svelte graphql gql prisma proto
    dockerfile
    makefile
    cmake
)

# Layer 1 — duti binds the extensions that have a registered type.
# The rest collect for the LSHandlers fallback below.
DUTI_BOUND=()
FALLBACK=()
for ext in "${EXTENSIONS[@]}"; do
    if duti -s "$APP" ".$ext" all 2>/dev/null; then
        log_info ".$ext"
        DUTI_BOUND+=("$ext")
    else
        FALLBACK+=("$ext")
    fi
done

# Layer 2 — bind the extensions duti could not bind (no registered type)
# via LSHandlers entries, in one atomic merge-write.
LSH_BOUND=0
if ((${#FALLBACK[@]} > 0)); then
    _oldIFS=$IFS
    IFS=','
    CSV="${FALLBACK[*]}"
    IFS=$_oldIFS
    if _out="$(python3 - "$CSV" <<'PY' 2>&1
import os, plistlib, subprocess, sys, tempfile

exts = {e.lower() for e in sys.argv[1].split(",") if e}
domain = "com.apple.LaunchServices/com.apple.launchservices.secure"

with tempfile.TemporaryDirectory() as tmp:
    src = os.path.join(tmp, "export.plist")
    dst = os.path.join(tmp, "import.plist")

    # Export failure: the domain is absent on a fresh machine — start empty.
    data = {}
    if subprocess.run(["defaults", "export", domain, src]).returncode == 0:
        with open(src, "rb") as f:
            data = plistlib.load(f)

    # Drop entries tagged with one of our extensions; keep everything else.
    handlers = [e for e in data.get("LSHandlers", [])
                if not (isinstance(e, dict)
                        and isinstance(e.get("LSHandlerContentTag"), str)
                        and e["LSHandlerContentTag"].lower() in exts)]
    handlers += [{"LSHandlerContentTag": ext,
                  "LSHandlerContentTagClass": "public.filename-extension",
                  "LSHandlerRoleAll": "com.microsoft.vscode"}
                 for ext in sorted(exts)]
    data["LSHandlers"] = handlers

    with open(dst, "wb") as f:
        plistlib.dump(data, f, fmt=plistlib.FMT_XML)
    proc = subprocess.run(["defaults", "import", domain, dst])

sys.exit(proc.returncode)
PY
)"; then
        LSH_BOUND=${#FALLBACK[@]}
        for ext in "${FALLBACK[@]}"; do
            log_info ".$ext (no registered type — bound by extension)"
        done
    else
        log_warn "LSHandlers fallback write failed: $_out"
    fi
fi

BOUND=$(( ${#DUTI_BOUND[@]} + LSH_BOUND ))
log_ok "VS Code set as default for $BOUND of ${#EXTENSIONS[@]} file types (${#DUTI_BOUND[@]} by type, $LSH_BOUND by extension)"

{{ else -}}

log_skip "VS Code default app bindings (not darwin)"

{{ end -}}
