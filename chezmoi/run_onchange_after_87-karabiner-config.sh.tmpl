#!/usr/bin/env bash
# run_onchange_after_87-karabiner-config.sh.tmpl
set -euo pipefail
source "{{ .chezmoi.sourceDir }}/shared/log.sh"

# Installs the Karabiner-Elements config manifest onto machines with no
# config yet. A machine with existing config is never overwritten — it is
# the source of truth and dump.sh observes it; to reset, delete the live
# file and re-apply. The manifest appears once dump.sh captures a
# configured machine (glob-guarded: rendering must not fail while absent).
# presence fact — flips the hash when the live config appears/disappears:
#   live karabiner.json: {{ output "sh" "-c" "test -f $HOME/.config/karabiner/karabiner.json && echo present || echo absent" | trim }}
# karabiner manifest: {{ if (glob "manifests/karabiner/karabiner.json") }}{{ include "manifests/karabiner/karabiner.json" | sha256sum }}{{ else }}absent{{ end }}

{{ if eq .chezmoi.os "darwin" -}}

log_section "karabiner config"

MANIFEST="{{ .chezmoi.sourceDir }}/manifests/karabiner/karabiner.json"
LIVE="$HOME/.config/karabiner/karabiner.json"

if [ ! -f "$MANIFEST" ]; then
    log_skip "karabiner config (no manifest in repo yet — dump.sh will capture a configured machine)"
    exit 0
fi

if [ -f "$LIVE" ]; then
    log_skip "karabiner config (existing config — dump.sh observes it; delete $LIVE and re-apply to reset to repo state)"
    exit 0
fi

mkdir -p "$HOME/.config/karabiner"
cp "$MANIFEST" "$LIVE"
log_ok "karabiner config installed"

{{ else -}}

log_skip "karabiner config (not darwin)"

{{ end -}}
