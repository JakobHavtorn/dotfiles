#!/usr/bin/env bash
# run_onchange_after_80-launchd-load.sh.tmpl
set -euo pipefail
source "{{ .chezmoi.sourceDir }}/shared/log.sh"

# Reload the dump schedule into launchd; re-fires whenever the plist itself
# changes. chezmoi's re-run trigger is this script's rendered content, so the
# plist hash lives inside the script — without it, a plist-only edit would
# leave launchd serving the stale schedule.
# plist hash: {{ include "Library/LaunchAgents/com.jakobhavtorn.dotfiles-dump.plist.tmpl" | sha256sum }}

{{ if eq .chezmoi.os "darwin" -}}

PLIST="$HOME/Library/LaunchAgents/com.jakobhavtorn.dotfiles-dump.plist"

if [[ ! -f "$PLIST" ]]; then
    log_skip "launchd load (plist not present)"
    exit 0
fi

log_section "loading dump.sh launchd job"

# Unload if already loaded, then load fresh
launchctl unload "$PLIST" 2>/dev/null || true
launchctl load "$PLIST"

log_ok "loaded: $PLIST"
log_info "schedule: daily at 10:00 (catch-up if missed)"

{{ else -}}

log_skip "launchd load (not darwin)"

{{ end -}}
