#!/usr/bin/env bash
# run_onchange_after_19-macos-apps.sh.tmpl
set -euo pipefail
source "{{ .chezmoi.sourceDir }}/shared/log.sh"
source "{{ .chezmoi.sourceDir }}/shared/env.sh"
source "{{ .chezmoi.sourceDir }}/shared/manifest.sh"

{{ if eq .chezmoi.os "darwin" -}}

# Install self-updating apps from vendor downloads when missing, and link
# their CLIs into ~/.local/bin. Runs before brew bundle (20) because the
# Brewfile's `vscode` lines need the `code` CLI linked here.
# Re-runs when this script or macos-apps.txt changes.

# macos-apps.txt hash: {{ include "manifests/macos-apps.txt" | sha256sum }}

MANIFEST="${MANIFEST:-"{{ .chezmoi.sourceDir }}/manifests/macos-apps.txt"}"
SYSTEM_APPS_DIR="${SYSTEM_APPS_DIR:-/Applications}"
USER_APPS_DIR="${USER_APPS_DIR:-$HOME/Applications}"
LOCAL_BIN="${LOCAL_BIN:-$HOME/.local/bin}"

# Same reason the brew bundle script skips casks in CI: large GUI
# downloads that the bootstrap test doesn't exercise.
if is_ci; then
    log_skip "macOS apps (CI)"
    exit 0
fi

log_section "macOS apps"

WORK_DIR="$(mktemp -d)"
MOUNT_POINT=""

# Detach any DMG still attached, then drop the downloads. Runs on exit so
# an interrupted install never leaves a stale mount; a stale mount makes
# every later attach of the same image fail with "Resource busy".
cleanup() {
    if [[ -n "$MOUNT_POINT" ]]; then
        hdiutil detach -quiet "$MOUNT_POINT" || hdiutil detach -quiet -force "$MOUNT_POINT" || true
    fi
    rm -rf "$WORK_DIR"
}
trap cleanup EXIT

# Print the path of an installed app bundle, or nothing if it isn't
# installed in either applications folder.
find_app() {
    local app="$1" dir
    for dir in "$SYSTEM_APPS_DIR" "$USER_APPS_DIR"; do
        if [[ -d "$dir/$app" ]]; then
            printf '%s\n' "$dir/$app"
            return 0
        fi
    done
    return 0
}

# Print the folder new apps go into: /Applications when writable (admin
# users), else ~/Applications, which every user can write.
install_dir() {
    if [[ -w "$SYSTEM_APPS_DIR" ]]; then
        printf '%s\n' "$SYSTEM_APPS_DIR"
    else
        mkdir -p "$USER_APPS_DIR"
        printf '%s\n' "$USER_APPS_DIR"
    fi
}

# Copy an app bundle out of a downloaded DMG or zip into dest_dir.
# Detects the format from the file's magic bytes, since vendor "latest"
# URLs often have no extension. Returns non-zero on failure.
copy_app_from_download() {
    local download="$1" app="$2" dest_dir="$3"

    # Zip files start with "PK" (hex 50 4b).
    if [[ "$(od -An -N2 -tx1 "$download" | tr -d ' \n')" == "504b" ]]; then
        local extract="$WORK_DIR/extract"
        rm -rf "$extract"
        ditto -x -k "$download" "$extract" 2>&1 | log_tee || return 1
        [[ -d "$extract/$app" ]] || return 1
        ditto "$extract/$app" "$dest_dir/$app" 2>&1 | log_tee
        rm -rf "$extract"
        return 0
    fi

    MOUNT_POINT="$WORK_DIR/mount"
    mkdir -p "$MOUNT_POINT"
    if ! hdiutil attach -quiet -nobrowse -readonly -mountpoint "$MOUNT_POINT" "$download"; then
        MOUNT_POINT=""
        return 1
    fi
    local rc=0
    if [[ -d "$MOUNT_POINT/$app" ]]; then
        ditto "$MOUNT_POINT/$app" "$dest_dir/$app" 2>&1 | log_tee || rc=$?
    else
        rc=1
    fi
    hdiutil detach -quiet "$MOUNT_POINT" || hdiutil detach -quiet -force "$MOUNT_POINT" || log_warn "could not detach $MOUNT_POINT"
    MOUNT_POINT=""
    return "$rc"
}

# Link a CLI shipped inside an app bundle into LOCAL_BIN.
link_bundle_bin() {
    local app_path="$1" bin_in_bundle="$2"
    local target="$app_path/$bin_in_bundle"
    local name
    name="$(basename "$bin_in_bundle")"
    if [[ ! -x "$target" ]]; then
        log_warn "$name: not found at $target"
        return 0
    fi
    mkdir -p "$LOCAL_BIN"
    ln -sf "$target" "$LOCAL_BIN/$name"
    log_ok "$name linked to $LOCAL_BIN"
}

# Install one app from the manifest. Called by manifest_each with the
# pipe-delimited fields: app_bundle, url, bin_in_bundle. Failures are
# logged and skipped, so one broken download never blocks the apply.
install_macos_app() {
    local app="$1" url="$2" bin_in_bundle="$3"
    local app_path
    app_path="$(find_app "$app")"

    if [[ -n "$app_path" ]]; then
        log_ok "$app: already installed at $(dirname "$app_path") (updates itself)"
    else
        local dest_dir download="$WORK_DIR/download"
        dest_dir="$(install_dir)"
        log_info "installing $app into $dest_dir..."
        if ! curl -fsSL "$url" -o "$download" 2>&1 | log_tee; then
            log_warn "$app: download failed ($url)"
            return 0
        fi
        if ! copy_app_from_download "$download" "$app" "$dest_dir"; then
            log_warn "$app: could not extract from $url"
            rm -f "$download"
            return 0
        fi
        rm -f "$download"
        app_path="$dest_dir/$app"
        log_ok "$app installed"
    fi

    if [[ "$bin_in_bundle" != "-" ]]; then
        link_bundle_bin "$app_path" "$bin_in_bundle"
    fi
}

manifest_each "$MANIFEST" "|" install_macos_app

log_ok "macOS apps done"

{{ else -}}

log_skip "macOS apps (not darwin)"

{{ end -}}
