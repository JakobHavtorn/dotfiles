#!/usr/bin/env bash
# run_onchange_after_21-macos-apps.sh.tmpl
set -euo pipefail
source "{{ .chezmoi.sourceDir }}/shared/log.sh"
source "{{ .chezmoi.sourceDir }}/shared/env.sh"
source "{{ .chezmoi.sourceDir }}/shared/manifest.sh"

{{ if eq .chezmoi.os "darwin" -}}

# Install self-updating apps from vendor DMGs when missing.
# Re-runs when this script or macos-apps.txt changes.

# macos-apps.txt hash: {{ include "manifests/macos-apps.txt" | sha256sum }}

MANIFEST="${MANIFEST:-"{{ .chezmoi.sourceDir }}/manifests/macos-apps.txt"}"
APPS_DIR="${APPS_DIR:-/Applications}"

# Same reason the brew bundle script skips casks in CI: large GUI
# downloads that the bootstrap test doesn't exercise.
if is_ci; then
    log_skip "macOS apps (CI)"
    exit 0
fi

log_section "macOS apps"

WORK_DIR="$(mktemp -d)"
MOUNT_POINT=""

# Detach any DMG still attached, then drop the downloads. Runs on exit so
# an interrupted install never leaves a stale mount; a stale mount makes
# every later attach of the same image fail with "Resource busy".
cleanup() {
    if [[ -n "$MOUNT_POINT" ]]; then
        hdiutil detach -quiet "$MOUNT_POINT" || hdiutil detach -quiet -force "$MOUNT_POINT" || true
    fi
    rm -rf "$WORK_DIR"
}
trap cleanup EXIT

# Install one app from the manifest. Called by manifest_each with the
# pipe-delimited fields: app_bundle, dmg_url. Failures are logged and
# skipped, so one broken download never blocks the rest of the apply.
install_macos_app() {
    local app="$1" url="$2"
    local dest="$APPS_DIR/$app"

    if [[ -d "$dest" ]]; then
        log_ok "$app: installed (updates itself)"
        return 0
    fi

    if [[ ! -w "$APPS_DIR" ]]; then
        log_warn "$app: missing, and $APPS_DIR is not writable by $(id -un)"
        log_info "install it by hand from $url"
        return 0
    fi

    log_info "installing $app..."
    local dmg="$WORK_DIR/download.dmg"
    if ! curl -fsSL "$url" -o "$dmg"; then
        log_warn "$app: download failed ($url)"
        return 0
    fi

    MOUNT_POINT="$WORK_DIR/mount"
    mkdir -p "$MOUNT_POINT"
    if ! hdiutil attach -quiet -nobrowse -readonly -mountpoint "$MOUNT_POINT" "$dmg"; then
        log_warn "$app: could not attach $dmg"
        MOUNT_POINT=""
        return 0
    fi

    if [[ -d "$MOUNT_POINT/$app" ]] && ditto "$MOUNT_POINT/$app" "$dest"; then
        log_ok "$app installed"
    else
        log_warn "$app: copy from DMG failed"
    fi

    hdiutil detach -quiet "$MOUNT_POINT" || hdiutil detach -quiet -force "$MOUNT_POINT" || log_warn "$app: could not detach $MOUNT_POINT"
    MOUNT_POINT=""
    rm -f "$dmg"
}

manifest_each "$MANIFEST" "|" install_macos_app

log_ok "macOS apps done"

{{ else -}}

log_skip "macOS apps (not darwin)"

{{ end -}}
