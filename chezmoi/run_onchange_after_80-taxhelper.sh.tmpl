#!/usr/bin/env bash
set -euo pipefail
source "{{ .chezmoi.sourceDir }}/shared/log.sh"
source "{{ .chezmoi.sourceDir }}/shared/env.sh"

# presence fact — flips this script's content hash when the precondition
# changes, so a guard-skip never permanently silences this layer:
#   taxhelper: {{ output "sh" "-c" "PATH=/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH command -v taxhelper >/dev/null 2>&1 && echo present || echo absent" | trim }}
#   identity: {{ .identity }}
# Install taxhelper agent skills into ~/.agents/skills (universal store).
# Taxhelper itself is installed via pipx (see manifests/pipx.txt).
# Re-runs when this script changes.

if is_ci; then
    log_skip "taxhelper skills (CI environment)"
    exit 0
fi

{{ if ne .identity "personal" }}
log_skip "taxhelper skills (personal identity only)"
exit 0
{{ end }}

if ! command -v taxhelper >/dev/null 2>&1; then
    log_skip "taxhelper skills (taxhelper not installed)"
    exit 0
fi

log_section "taxhelper skills"
# stderr stays discarded (as before); only stdout reaches the session log
taxhelper install-skills --target agents --force 2>/dev/null | log_tee || {
    log_warn "taxhelper install-skills failed"
}
log_ok "taxhelper skills done"
