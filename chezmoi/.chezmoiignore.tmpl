{{ if eq .chezmoi.os "linux" }}
# k9s is installed via Homebrew (darwin only); config is noise on Linux
.config/k9s
# Library/LaunchAgents is macOS-only
Library/
# Claude Code self-healing wrapper targets the Homebrew npm prefix (darwin only)
.claude/bin
{{ end }}

{{ if ne .identity "work" }}
# corti models wiring is work-only (models.yml.tmpl renders corti providers)
.omp/agent/models.yml
{{ end }}

# Files inside the chezmoi root that aren't home targets
.chezmoi.toml.tmpl
.chezmoidata.yaml
.chezmoiignore.tmpl
shared
manifests

# opencode.jsonc is managed by run_onchange_after_20-opencode-config.sh.tmpl
# (template render; model wiring lives in run_onchange_after_25-corti-models.sh.tmpl),
# not by chezmoi's file mechanism
.config/opencode/opencode.jsonc

# cli.json is managed by run_onchange_after_20-opencode-config.sh.tmpl
# (template render) + run_onchange_after_85-herdr-plugins.sh.tmpl (herdr integration),
# not by chezmoi's file mechanism
.config/opencode/cli.json

# pi mcp.json is managed by run_onchange_after_22-pi-config.sh.tmpl
# (template render), not by chezmoi's file mechanism — Pi itself writes
# enable/exposure toggles and `pi mcp add` servers into this file, so a
# direct source file would revert live changes on every apply
.pi/agent/mcp.json
