#!/usr/bin/env bash
set -euo pipefail
source "{{ .chezmoi.sourceDir }}/shared/log.sh"
source "{{ .chezmoi.sourceDir }}/shared/env.sh"

# presence fact — flips this script's content hash when the precondition
# changes, so a guard-skip never permanently silences this layer:
#   brew: {{ output "sh" "-c" "command -v brew >/dev/null 2>&1 && echo present || echo absent" | trim }}

{{ if eq .chezmoi.os "darwin" -}}

# Install all formulae, casks, and extensions from the Brewfile.
# Re-runs when this script or the Brewfile changes.

# Brewfile hash: {{ include "manifests/Brewfile" | sha256sum }}

BREWFILE="${BREWFILE:-"{{ .chezmoi.sourceDir }}/manifests/Brewfile"}"

# Resolve brew directly when it is not on PATH yet — run_before_10 cannot
# export PATH back into chezmoi's process, so a same-apply install needs this.
BREW_BIN="$(command -v brew || true)"
if [ -z "$BREW_BIN" ]; then
    if [ -x /opt/homebrew/bin/brew ]; then
        BREW_BIN=/opt/homebrew/bin/brew
    elif [ -x /usr/local/bin/brew ]; then
        BREW_BIN=/usr/local/bin/brew
    fi
fi
if [ -z "$BREW_BIN" ]; then
    log_skip "brew bundle (homebrew not installed)"
    exit 0
fi
eval "$("$BREW_BIN" shellenv)"

log_section "brew bundle install"

# In CI, skip VS Code extensions and GUI app casks — marketplace 503s are
# transient, and casks need /Applications access (sudo) that headless runners
# can't provide. Neither is part of the system bootstrap we're testing.
if is_ci; then
    BREWFILE_FILTERED="$(mktemp)"
    grep -v -E '^vscode |^cask ' "$BREWFILE" > "$BREWFILE_FILTERED"
    brew bundle install --file "$BREWFILE_FILTERED"
    rm -f "$BREWFILE_FILTERED"
else
    brew bundle install --file "$BREWFILE"
fi

log_ok "brew bundle done"

{{ else -}}

log_skip "brew bundle (not darwin)"

{{ end -}}
