#!/usr/bin/env bash
set -euo pipefail
source "{{ .chezmoi.sourceDir }}/shared/log.sh"
source "{{ .chezmoi.sourceDir }}/shared/env.sh"

{{ if eq .chezmoi.os "darwin" -}}

# Install all formulae, casks, and extensions from the Brewfile.
# Re-runs when this script or the Brewfile changes.

# Brewfile hash: {{ include "manifests/Brewfile" | sha256sum }}

BREWFILE="${BREWFILE:-"{{ .chezmoi.sourceDir }}/manifests/Brewfile"}"

if ! command -v brew >/dev/null 2>&1; then
    log_skip "brew bundle (homebrew not installed)"
    exit 0
fi

log_section "brew bundle install"

# In CI, skip VS Code extensions — marketplace 503s are transient and
# extensions aren't part of the system bootstrap we're testing.
if is_ci; then
    BREWFILE_FILTERED="$(mktemp)"
    grep -v '^vscode ' "$BREWFILE" > "$BREWFILE_FILTERED"
    brew bundle install --file "$BREWFILE_FILTERED"
    rm -f "$BREWFILE_FILTERED"
else
    brew bundle install --file "$BREWFILE"
fi

log_ok "brew bundle done"

{{ else -}}

log_skip "brew bundle (not darwin)"

{{ end -}}
