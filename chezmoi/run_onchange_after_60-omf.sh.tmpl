#!/usr/bin/env bash
# run_onchange_after_60-omf.sh.tmpl
set -euo pipefail
source "{{ .chezmoi.sourceDir }}/shared/log.sh"
source "{{ .chezmoi.sourceDir }}/shared/env.sh"
source "{{ .chezmoi.sourceDir }}/shared/manifest.sh"

# presence fact — flips this script's content hash when the precondition
# changes, so a guard-skip never permanently silences this layer:
#   fish: {{ output "sh" "-c" "PATH=/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH command -v fish >/dev/null 2>&1 && echo present || echo absent" | trim }}
# Install OMF packages and themes from manifest.
# Re-runs when this script or the manifest changes.
# omf hash: {{ include "manifests/omf.txt" | sha256sum }}

if ! command -v fish >/dev/null 2>&1; then
    log_skip "OMF (fish not installed)"
    exit 0
fi

# Install OMF itself if missing
if ! fish -c 'type -q omf' 2>/dev/null; then
    log_info "installing Oh My Fish..."
    curl -fsSL https://raw.githubusercontent.com/oh-my-fish/oh-my-fish/master/bin/install -o /tmp/omf-install.fish
    if fish /tmp/omf-install.fish --noninteractive --yes >/dev/null 2>&1; then
        log_ok "Oh My Fish installed"
    else
        log_err "Oh My Fish install failed"
        rm -f /tmp/omf-install.fish
        exit 1
    fi
    rm -f /tmp/omf-install.fish
fi

MANIFEST="${MANIFEST:-"{{ .chezmoi.sourceDir }}/manifests/omf.txt"}"

log_section "OMF packages"

# Install a single OMF package/theme. Called by manifest_each with the
# pipe-delimited fields: type, name.
install_omf_package() {
    local type="$1" name="$2"
    log_info "$type: $name"
    if fish -c "omf install $name" >/dev/null 2>&1; then
        log_ok "$name"
    else
        log_warn "$name install failed"
    fi
}

manifest_each "$MANIFEST" "|" install_omf_package

log_ok "OMF done"
