{{- $work := eq $.identity "work" -}}
{{- $mcpVisible := dict -}}
{{- range $name, $srv := .coding_agents.mcp.servers }}
{{- if or (eq (dig "identity" "" $srv) "") (eq (dig "identity" "" $srv) $.identity) }}
{{- $mcpVisible = set $mcpVisible $name true }}
{{- end }}
{{- end -}}
{
  "$schema": "https://opencode.ai/config.json",
{{- if $work }}
  "providers": {
    "corti": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Corti",
      "settings": {
        "baseURL": "https://ai.eu.corti.app/v1",
        "apiKey": "{env:CORTI_BEARER}"
      }
    }
  },
  "model": "corti/{{ .coding_agents.corti.default_model }}",
{{- end }}
  "permissions": [
{{- range $i, $action := .coding_agents.notion.deny_wildcards }}
    { "action": "notion_notion-{{ $action }}", "resource": "*", "effect": "deny" },
{{- end }}
{{- range $i, $action := .coding_agents.notion.deny_actions }}
    { "action": "notion_notion-{{ $action }}", "resource": "*", "effect": "deny" }{{ if lt $i (sub (len $.coding_agents.notion.deny_actions) 1) }},{{ end }}
{{- end }}
  ],
  "mcp": {
    "servers": {
      "linear": {
        "type": "remote",
        "url": "{{ .coding_agents.mcp.servers.linear.url }}",
        "oauth": {},
        "disabled": false,
        "timeout": { "catalog": 30000, "execution": 30000 }
      },
      "slack": {
        "type": "remote",
        "url": "{{ .coding_agents.mcp.servers.slack.url }}",
        "oauth": {
          "client_id": "{env:SLACK_CLIENT_ID}",
          "client_secret": "{env:SLACK_CLIENT_SECRET}",
          "scope": "{{ .coding_agents.mcp.servers.slack.scope }}",
          "callback_port": {{ .coding_agents.mcp.servers.slack.callback_port }},
          "redirect_uri": "{{ .coding_agents.mcp.servers.slack.redirect_uri }}"
        },
        "disabled": false,
        "timeout": { "catalog": 30000, "execution": 30000 }
      }{{ if index $mcpVisible "synapse" }},
      "synapse": {
        "type": "remote",
        "url": "{{ .coding_agents.mcp.servers.synapse.url }}",
        "oauth": {
          "client_id": "{{ .coding_agents.mcp.servers.synapse.oauth_client_id }}",
          "scope": "{{ .coding_agents.mcp.servers.synapse.oauth_scope }}"
        },
        "disabled": false,
        "timeout": { "catalog": 30000, "execution": 30000 }
      }{{ end }},
      "notion": {
        "type": "remote",
        "url": "{{ .coding_agents.mcp.servers.notion.url }}",
        "oauth": {},
        "disabled": false,
        "timeout": { "catalog": 30000, "execution": 30000 }
      }{{ if index $mcpVisible "corti_docs" }},
      "corti_docs": {
        "type": "remote",
        "url": "{{ .coding_agents.mcp.servers.corti_docs.url }}",
        "oauth": {},
        "disabled": false,
        "timeout": { "catalog": 30000, "execution": 30000 }
      }{{ end }},
      "obsidian": {
        "type": "remote",
        "url": "{{ .coding_agents.mcp.servers.obsidian.url }}",
        "headers": {
          "Authorization": "Bearer {env:OBSIDIAN_LOCAL_REST_MCP_TOKEN}"
        },
        "disabled": false,
        "timeout": { "catalog": 30000, "execution": 30000 }
      }{{ if index $mcpVisible "handle" }},
      "handle": {
        "type": "local",
        "command": ["{{ $.coding_agents.mcp.servers.handle.command }}"{{ range $i, $arg := $.coding_agents.mcp.servers.handle.args }}, "{{ $arg }}"{{ end }}],
        "enabled": true
      }{{ end }}
    }
  },
  "plugins": [
    "@plannotator/opencode@latest",
    "@cortexkit/aft-opencode@latest"
  ],
  "compaction": {
    "auto": false
  }
}
