{
  "$schema": "https://opencode.ai/v2/cli.json",
  "plugins": [
    "@cortexkit/aft-opencode@latest"
  ],
  "scroll": {
    "acceleration": false
  },
  "diffs": {
    "source": "branch",
    "wrap": "word",
    "tree": true,
    "single": false,
    "view": "auto"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "tabs": {
    "mode": "off"
  },
  "animations": true
}
